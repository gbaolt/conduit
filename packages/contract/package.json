{
  "name": "@conduit/contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "typecheck": "tsc --noEmit",
    "dev": "tsc-watch --compiler typescript/bin/tsc6 --onSuccess \"tsc-alias\""
  },
  "dependencies": {
    "@orpc/contract": "catalog:",
    "@orpc/openapi": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conduit/config": "workspace:*",
    "@typescript/native": "catalog:",
    "tsc-alias": "^1.9.2",
    "tsc-watch": "^7.2.1",
    "typescript": "catalog:"
  }
}
