{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "portless conduit next dev",
    "build": "next build",
    "start": "portless conduit next start",
    "conduit": "next build && portless conduit next start",
    "lint": "eslint .",
    "lint:fix": "eslint -- --fix .",
    "typecheck": "next typegen && tsc --noEmit --extendedDiagnostics",
