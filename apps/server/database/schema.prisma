generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Same client for the Cloudflare Worker, which cannot compile Wasm from bytes at runtime.
generator worker {
  provider      = "prisma-client"
  output        = "../generated/prisma-worker"
  runtime       = "workerd"
  compilerBuild = "small"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String           @id @default(cuid())
  name               String
  email              String           @unique
  emailVerified      Boolean          @default(false)
  image              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  sessions           Session[]
  accounts           Account[]
  members            Member[]
  invitations        Invitation[]
  channelsCreated    Channel[]        @relation("ChannelCreatedBy")
  channelsArchived   Channel[]        @relation("ChannelArchivedBy")
  channelMemberships ChannelMember[]
  channelSections    ChannelSection[]
  messages           Message[]
  savedMessages      SavedMessage[]
  summaries          Summary[]
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@index([userId])
}

model Organization {
  id              String             @id @default(cuid())
  name            String
  slug            String             @unique
  logo            String?
  createdAt       DateTime
  metadata        String?
  members         Member[]
  invitations     Invitation[]
  channels        Channel[]
  channelSections ChannelSection[]
  joinLink        WorkspaceJoinLink?
  allowedDomains  AllowedDomain[]
  settings        WorkspaceSettings?
  summaries       Summary[]
}

model Member {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime
  deactivation   MemberDeactivation?

  @@index([organizationId])
  @@index([userId])
}

/// App-owned. A row means the member is deactivated; reactivating deletes it.
model MemberDeactivation {
  memberId        String   @id
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  deactivatedAt   DateTime @default(now())
  deactivatedById String
}

/// App-owned. The workspace's shareable join link; resetting replaces the token.
model WorkspaceJoinLink {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  token          String       @unique
  createdById    String
  createdAt      DateTime     @default(now())
}

/// App-owned. A verified email on this domain may join the workspace without an invitation.
model AllowedDomain {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domain         String

  @@id([organizationId, domain])
  @@index([domain])
}

enum ChannelCreators {
  EVERYONE
  ADMINS
}

/// App-owned. No row means every setting is at its default, so there is no backfill.
model WorkspaceSettings {
  organizationId        String          @id
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelCreators       ChannelCreators @default(EVERYONE)
  publicChannelCreators ChannelCreators @default(EVERYONE)
  aiEnabled             Boolean         @default(true)
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  createdAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  issuer                String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

enum ChannelVisibility {
  PUBLIC
  PRIVATE
}

enum ChannelRole {
  MANAGER
  MEMBER
}

enum ChannelKind {
  CHANNEL
  DM
}

model Channel {
  id                       String            @id @default(cuid())
  organizationId           String
  organization             Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                     String // toChannelName output, shown with a # prefix
  topic                    String?
  description              String?
  kind                     ChannelKind       @default(CHANNEL)
  dmKey                    String?           @unique // `<organizationId>:<sorted user ids>`, set only on a DM
  lastMessageAt            DateTime?
  visibility               ChannelVisibility @default(PUBLIC)
  defaultForOrganizationId String?           @unique // set only on the workspace's default channel
  createdById              String?
  createdBy                User?             @relation("ChannelCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  archivedAt               DateTime?
  archivedById             String?
  archivedBy               User?             @relation("ChannelArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  members                  ChannelMember[]
  messages                 Message[]
  summaries                Summary[]

  @@unique([organizationId, name])
}

model ChannelMember {
  channelId String
  channel   Channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ChannelRole     @default(MEMBER)
  starredAt DateTime?
  sectionId String?
  section   ChannelSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  joinedAt  DateTime        @default(now())

  @@id([channelId, userId])
  @@index([userId])
}

model ChannelSection {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  position       Int
  createdAt      DateTime        @default(now())
  channels       ChannelMember[]

  @@unique([userId, organizationId, name])
}

/// App-owned. The live query reads `updatedAt`, so every change to a row must bump it.
model Message {
  id                String         @id @default(cuid())
  channelId         String
  channel           Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId          String
  author            User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// Chosen by the sender's client, so a retried send is one row.
  clientId          String
  parentId          String?
  parent            Message?       @relation("MessageReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies           Message[]      @relation("MessageReplies")
  savedBy           SavedMessage[]
  alsoSentToChannel Boolean        @default(false)
  /// Markdown text, at most 4,000 characters. Cleared when the message is deleted.
  body              String
  mentionedUserIds  String[]
  mentionsChannel   Boolean        @default(false)
  mentionsHere      Boolean        @default(false)
  /// `Record<emoji, userId[]>`.
  reactions         Json           @default("{}")
  replyCount        Int            @default(0)
  lastReplyAt       DateTime?
  linkPreview       Json?
  pinnedAt          DateTime?
  pinnedById        String?
  editedAt          DateTime?
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([authorId, clientId])
  @@index([channelId, parentId, createdAt, id])
  @@index([channelId, updatedAt])
}

/// App-owned. A member's private bookmark on a message.
model SavedMessage {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  savedAt   DateTime @default(now())

  @@id([userId, messageId])
  @@index([userId, savedAt])
}

/// App-owned. An AI summary of a thread or a channel's log. Only the requester reads it until `sharedMessageId` is set.
model Summary {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requesterId      String
  requester        User         @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  channelId        String
  channel          Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// The thread's root message. Null for a channel summary.
  parentId         String?
  from             DateTime?
  to               DateTime?
  /// How many messages the model read.
  messageCount     Int
  /// `{ text, sourceIds }[]`, with every source id a message the model read.
  bullets          Json
  /// The cited messages in order of first citation.
  sourceMessageIds String[]
  /// The message that shared this summary into the conversation.
  sharedMessageId  String?
  createdAt        DateTime     @default(now())

  @@index([requesterId, createdAt])
}
