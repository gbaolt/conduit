generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Same client for the Cloudflare Worker, which cannot compile Wasm from bytes at runtime.
generator worker {
  provider      = "prisma-client"
  output        = "../generated/prisma-worker"
  runtime       = "workerd"
  compilerBuild = "small"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  emailVerified         Boolean                @default(false)
  image                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  sessions              Session[]
  accounts              Account[]
  members               Member[]
  invitations           Invitation[]
  channelsCreated       Room[]                 @relation("ChannelCreatedBy")
  channelsArchived      Room[]                 @relation("ChannelArchivedBy")
  roomMemberships       RoomMember[]
  channelSections       ChannelSection[]
  readStates            ReadState[]
  drafts                Draft[]
  typingStates          TypingState[]
  presences             Presence[]
  messages              Message[]
  savedMessages         SavedMessage[]
  summaries             Summary[]
  askChats              AskChat[]
  askAttachments        AskAttachment[]
  notificationSettings  NotificationSettings[]
  activityItems         ActivityItem[]         @relation("ActivityRecipient")
  activityActed         ActivityItem[]         @relation("ActivityActor")
  pushSubscriptions     PushSubscription[]
  digestStates          DigestState[]
  files                 File[]
  canvasesCreated       Canvas[]               @relation("CanvasCreatedBy")
  canvasesUpdated       Canvas[]               @relation("CanvasUpdatedBy")
  canvasMemberships     CanvasMember[]         @relation("CanvasMemberUser")
  canvasMembersAdded    CanvasMember[]         @relation("CanvasMemberAddedBy")
  canvasThreadsCreated  CanvasCommentThread[]  @relation("CanvasThreadCreatedBy")
  canvasThreadsResolved CanvasCommentThread[]  @relation("CanvasThreadResolvedBy")
  canvasComments        CanvasComment[]
  canvasVersions        CanvasVersion[]
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@index([userId])
}

model Organization {
  id                   String                 @id @default(cuid())
  name                 String
  slug                 String                 @unique
  logo                 String?
  createdAt            DateTime
  metadata             String?
  members              Member[]
  invitations          Invitation[]
  rooms                Room[]
  channelSections      ChannelSection[]
  joinLink             WorkspaceJoinLink?
  allowedDomains       AllowedDomain[]
  settings             WorkspaceSettings?
  summaries            Summary[]
  askChats             AskChat[]
  askAttachments       AskAttachment[]
  presences            Presence[]
  notificationSettings NotificationSettings[]
  digestStates         DigestState[]
  files                File[]
  searchSyncs          SearchSync[]
  canvases             Canvas[]
  canvasCommentThreads CanvasCommentThread[]
  canvasVersions       CanvasVersion[]
}

model Member {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime
  deactivation   MemberDeactivation?

  @@index([organizationId])
  @@index([userId])
}

/// App-owned. A row means the member is deactivated; reactivating deletes it.
model MemberDeactivation {
  memberId        String   @id
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  deactivatedAt   DateTime @default(now())
  deactivatedById String
}

/// App-owned. The workspace's shareable join link; resetting replaces the token.
model WorkspaceJoinLink {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  token          String       @unique
  createdById    String
  createdAt      DateTime     @default(now())
}

/// App-owned. A verified email on this domain may join the workspace without an invitation.
model AllowedDomain {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domain         String

  @@id([organizationId, domain])
  @@index([domain])
}

enum ChannelCreators {
  EVERYONE
  ADMINS
}

/// App-owned. No row means every setting is at its default, so there is no backfill.
model WorkspaceSettings {
  organizationId        String          @id
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelCreators       ChannelCreators @default(EVERYONE)
  publicChannelCreators ChannelCreators @default(EVERYONE)
  aiEnabled             Boolean         @default(true)
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  createdAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  issuer                String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

enum ChannelVisibility {
  PUBLIC
  PRIVATE
}

/// Who a channel's posting permission lets through. MANAGERS means channel managers and workspace admins.
enum ChannelAudience {
  EVERYONE
  MANAGERS
}

enum RoomRole {
  MANAGER
  MEMBER

  @@map("ChannelRole")
}

/// What a member is notified about in a room. A null `RoomMember.notify` means the default for the room's kind.
enum NotifyLevel {
  ALL
  MENTIONS
  NOTHING
}

enum RoomKind {
  CHANNEL
  DM

  @@map("ChannelKind")
}

model Room {
  id                       String            @id @default(cuid())
  organizationId           String
  organization             Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                     String // toChannelName output, shown with a # prefix
  topic                    String?
  description              String?
  kind                     RoomKind          @default(CHANNEL)
  dmKey                    String?           @unique // `<organizationId>:<sorted user ids>`, set only on a DM
  lastMessageAt            DateTime?
  visibility               ChannelVisibility @default(PUBLIC)
  postAudience             ChannelAudience   @default(EVERYONE) // who can start a message
  replyAudience            ChannelAudience   @default(EVERYONE) // who can reply in a thread
  mentionEveryoneAudience  ChannelAudience   @default(EVERYONE) // who can use @channel and @here
  defaultForOrganizationId String?           @unique // set only on the workspace's default channel
  createdById              String?
  createdBy                User?             @relation("ChannelCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  archivedAt               DateTime?
  archivedById             String?
  archivedBy               User?             @relation("ChannelArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  members                  RoomMember[]
  readStates               ReadState[]
  drafts                   Draft[]
  typingStates             TypingState[]
  messages                 Message[]
  summaries                Summary[]
  activityItems            ActivityItem[]
  files                    File[]
  canvases                 Canvas[]

  @@unique([organizationId, name])
  @@map("Channel")
}

model RoomMember {
  roomId    String          @map("channelId")
  room      Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      RoomRole        @default(MEMBER)
  starredAt DateTime?
  sectionId String?
  section   ChannelSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  notify    NotifyLevel?
  /// Set while the member has the room muted.
  mutedAt   DateTime?
  /// Set while the member has closed a DM. The DM counts as open again once a message arrives after it.
  closedAt  DateTime?
  joinedAt  DateTime        @default(now())

  @@id([roomId, userId])
  @@index([userId])
  @@map("ChannelMember")
}

model ChannelSection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  position       Int
  createdAt      DateTime     @default(now())
  channels       RoomMember[]

  @@unique([userId, organizationId, name])
}

/// App-owned. The live query reads `updatedAt`, so every change to a row must bump it.
model Message {
  id                String         @id @default(cuid())
  roomId            String         @map("channelId")
  room              Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  authorId          String
  author            User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// Chosen by the sender's client, so a retried send is one row.
  clientId          String
  parentId          String?
  parent            Message?       @relation("MessageReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies           Message[]      @relation("MessageReplies")
  savedBy           SavedMessage[]
  activityItems     ActivityItem[]
  alsoSentToChannel Boolean        @default(false)
  /// Markdown text, at most 4,000 characters. Cleared when the message is deleted.
  body              String
  mentionedUserIds  String[]
  mentionsChannel   Boolean        @default(false)
  mentionsHere      Boolean        @default(false)
  /// `Record<emoji, userId[]>`.
  reactions         Json           @default("{}")
  replyCount        Int            @default(0)
  lastReplyAt       DateTime?
  linkPreview       Json?
  /// `MessageFile[]`, copied from the attached `File` rows when the message is sent, so the live stream carries them.
  files             Json           @default("[]")
  attachedFiles     File[]
  pinnedAt          DateTime?
  pinnedById        String?
  editedAt          DateTime?
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([authorId, clientId])
  @@index([roomId, parentId, createdAt, id])
  @@index([roomId, updatedAt])
}

enum FileStatus {
  /// The upload URL was handed out and the bytes may not have arrived.
  PENDING
  /// Storage holds the object at the promised size.
  READY
}

/// App-owned. An uploaded file. Every row that is not deleted counts toward the workspace's storage cap, pending ones included.
model File {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploaderId     String
  uploader       User         @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  /// The room it was uploaded to. A message may attach it only in this room.
  roomId         String       @map("channelId")
  room           Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  /// Set once a message carries it.
  messageId      String?
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  name           String
  contentType    String
  size           Int
  /// `files/<organizationId>/<id>/<safe name>`, under a prefix the bucket never serves publicly.
  key            String       @unique
  width          Int?
  height         Int?
  status         FileStatus   @default(PENDING)
  createdAt      DateTime     @default(now())
  /// Set when its message is deleted or the upload is cancelled. The sweep removes the object, then the row.
  deletedAt      DateTime?
  /// How many chunks the search index holds for it, so a shorter re-extraction deletes the rest.
  indexedChunks  Int          @default(0)
  /// The original a copy was attached from, or null for an upload. A copy of a copy points at the original.
  /// No foreign key, so the link outlives the original's row and an admin can still find every copy.
  sourceFileId   String?

  @@index([sourceFileId])
  @@index([organizationId, createdAt, id])
  @@index([messageId])
  @@index([status, createdAt])
}

enum ActivityKind {
  MENTION
  THREAD_REPLY
  REACTION
  ROOM_ADD
}

enum ActivityUrgency {
  URGENT
  NORMAL
  LOW
}

/// App-owned. One row per thing that needs a member, written in the transaction of the change that caused it.
model ActivityItem {
  id             String           @id @default(cuid())
  organizationId String
  /// The recipient.
  userId         String
  user           User             @relation("ActivityRecipient", fields: [userId], references: [id], onDelete: Cascade)
  roomId         String           @map("channelId")
  room           Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  kind           ActivityKind
  /// Built by the server, so a retried write is one row: `message:<id>`, `reaction:<id>:<actorId>:<emoji>`, or `room-add:<roomId>:<joinedAt ms>`.
  key            String
  actorId        String
  actor          User             @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)
  messageId      String?
  message        Message?         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  emoji          String?
  /// What the model judged for the recipient. Null until `feed.rank` reaches the item, and always null for reactions and adds.
  urgency        ActivityUrgency?
  urgencyReason  String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, key])
  @@index([userId, organizationId, createdAt, id])
  @@index([userId, organizationId, readAt])
  @@index([messageId])
}

/// App-owned. A member's private bookmark on a message.
model SavedMessage {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  savedAt   DateTime @default(now())

  @@id([userId, messageId])
  @@index([userId, savedAt])
}

/// App-owned. An AI summary of a thread, a channel's log, or everything unread (a catch-up). Only the requester reads it until `sharedMessageId` is set.
model Summary {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requesterId      String
  requester        User         @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  /// Null for a catch-up, which spans every room the requester reads.
  roomId           String?      @map("channelId")
  room             Room?        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  /// The thread's root message. Null for a channel summary.
  parentId         String?
  from             DateTime?
  to               DateTime?
  /// How many messages the model read.
  messageCount     Int
  /// `{ text, sourceIds }[]`, with every source id a message the model read.
  bullets          Json
  /// The cited messages in order of first citation.
  sourceMessageIds String[]
  /// The message that shared this summary into the conversation.
  sharedMessageId  String?
  createdAt        DateTime     @default(now())

  @@index([requesterId, createdAt])
}

/// An Ask Conduit answer. Only its requester reads it.
/// One member's chat with Ask Conduit. Only its owner can read it.
model AskChat {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// The first question, cut at a word.
  title          String
  answers        Answer[]
  createdAt      DateTime     @default(now())
  /// Moves with each new answer, so the history lists the latest chat first.
  updatedAt      DateTime     @default(now())

  @@index([organizationId, ownerId, updatedAt])
}

/// One turn of an Ask chat: a question and its answer, stored together once the answer settles.
model Answer {
  id          String          @id @default(cuid())
  chatId      String
  chat        AskChat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  question    String
  /// False when the sources the asker could read didn't answer the question.
  found       Boolean
  /// Markdown, with each `[n]` citing `sources[n - 1]`.
  body        String
  /// `{ type: 'message' | 'file', id }[]`, the cited sources in order of first citation.
  sources     Json
  attachments AskAttachment[]
  createdAt   DateTime        @default(now())

  @@index([chatId, createdAt])
}

/// A file the asker attached to an Ask question. It belongs to the asker, not to a room, and nobody else reads it.
model AskAttachment {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Set once a question carries it. Deleting the chat sets it back to null, and the sweep removes the object.
  answerId       String?
  answer         Answer?      @relation(fields: [answerId], references: [id], onDelete: SetNull)
  /// `ask/<organizationId>/<ownerId>/<id>/<safe name>`, under a prefix the bucket never serves publicly.
  /// Null when `fileId` is set.
  key            String?      @unique
  /// Set when the asker picked a sent file from Files. Each read checks the asker can still open it, so no
  /// foreign key: a purged file reads as no longer available.
  fileId         String?
  name           String
  contentType    String
  size           Int
  width          Int?
  height         Int?
  /// Set once storage holds the promised bytes.
  ready          Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([answerId])
  @@index([createdAt])
}

/// App-owned. How far a member has read a conversation. The sidebar compares it with `Channel.lastMessageAt`.
model ReadState {
  roomId            String   @map("channelId")
  room              Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The `createdAt` of `lastReadMessageId`. Moves forward only.
  lastReadAt        DateTime
  lastReadMessageId String?

  @@id([roomId, userId])
  @@index([userId])
}

/// App-owned. One unsent message per member per conversation. A thread's draft sets `parentId`.
model Draft {
  roomId    String   @map("channelId")
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The thread root, or an empty string for the channel itself. Part of the key, so it cannot be null.
  parentId  String   @default("")
  body      String
  updatedAt DateTime @updatedAt

  @@id([roomId, userId, parentId])
  @@index([userId])
}

/// App-owned. A member is typing until `until`. Clients hide rows that have passed it.
model TypingState {
  roomId   String   @map("channelId")
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The thread root, or an empty string for the channel itself.
  parentId String   @default("")
  until    DateTime

  @@id([roomId, userId, parentId])
}

/// App-owned. A member is online when `lastActiveAt` is under 2 minutes old and `away` is false.
model Presence {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastActiveAt   DateTime
  away           Boolean      @default(false)

  @@id([organizationId, userId])
}

/// App-owned. A member's notification preferences in one workspace. No row means the defaults.
model NotificationSettings {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Do Not Disturb is on until this time. Past or null means off.
  dndUntil       DateTime?
  /// `{ days, start, end }`, parsed by `DndScheduleSchema`.
  dndSchedule    Json?
  /// An IANA time zone name that the schedule is read in.
  timeZone       String       @default("UTC")
  emailDigest    Boolean      @default(true)

  @@id([organizationId, userId])
}

/// App-owned. When a member's last email digest in a workspace went out. A digest sends only when this is older than the member's last heartbeat.
model DigestState {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSentAt     DateTime

  @@id([organizationId, userId])
}

/// App-owned. One row per browser that turned on desktop notifications. A browser handed to another account moves to it.
model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?

  @@index([userId])
}

enum SearchSyncKind {
  MESSAGE
  FILE
}

/// A message or file the search index must be made to match. Written in the transaction of the change, so none is lost.
/// The drain reads the target's current state, so running a row twice or out of order ends the same.
model SearchSync {
  kind           SearchSyncKind
  targetId       String
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// When it may run next. A drain claims a row by pushing this forward, so two drains never take the same row.
  dueAt          DateTime       @default(now())
  attempts       Int            @default(0)
  lastError      String?

  @@id([kind, targetId])
  @@index([organizationId, dueAt])
  @@index([dueAt])
}

enum CanvasRole {
  EDITOR
  VIEWER
}

/// A rich-text document. With a `roomId` it lives in that channel and inherits its access; without one it is
/// standalone and only its `CanvasMember` rows can open it.
model Canvas {
  id               String                @id @default(cuid())
  organizationId   String
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roomId           String?               @map("channelId")
  room             Room?                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  title            String
  /// One emoji.
  icon             String?
  /// A key of `CANVAS_COVER_PRESETS` in the contract.
  coverPreset      String?
  /// The Lexical editor state as JSON.
  snapshotJson     Json?
  /// The same content as Markdown, for search and AI.
  markdown         String                @default("")
  /// Markdown to seed the live Yjs document from on first open, such as an AI draft.
  initialMarkdown  String?
  contentHash      String?
  /// When a live Yjs document was first seeded from this row.
  seededAt         DateTime?
  /// The thread an AI draft was made from.
  sourceThreadId   String?
  createdById      String?
  createdBy        User?                 @relation("CanvasCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById      String?
  updatedBy        User?                 @relation("CanvasUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?
  members          CanvasMember[]
  commentThreads   CanvasCommentThread[]
  versions         CanvasVersion[]

  @@index([organizationId, roomId])
  @@index([organizationId, updatedAt(sort: Desc)])
}

/// Who may open a standalone canvas, and whether they may edit it.
model CanvasMember {
  canvasId  String
  canvas    Canvas     @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation("CanvasMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  role      CanvasRole
  addedById String?
  addedBy   User?      @relation("CanvasMemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())

  @@id([canvasId, userId])
  @@index([userId])
}

/// A comment thread on a passage of a canvas. The passage is a Lexical mark carrying the thread's id.
model CanvasCommentThread {
  id             String          @id @default(cuid())
  canvasId       String
  canvas         Canvas          @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// The commented text as it read when the thread started, kept after the text is edited or deleted.
  quote          String
  createdById    String
  createdBy      User            @relation("CanvasThreadCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?           @relation("CanvasThreadResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  comments       CanvasComment[]

  @@index([canvasId, resolvedAt, createdAt])
}

model CanvasComment {
  id               String              @id @default(cuid())
  threadId         String
  thread           CanvasCommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId         String
  author           User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body             String
  mentionedUserIds String[]            @default([])
  editedAt         DateTime?
  deletedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([threadId, createdAt])
}

/// What recorded a canvas version: the 5-minute autosave, a person saving one, a restore, or an AI draft.
enum CanvasVersionTrigger {
  AUTO
  MANUAL
  RESTORE
  AI_DRAFT
}

/// A saved copy of a canvas's content, kept for as long as the canvas.
model CanvasVersion {
  id             String               @id @default(cuid())
  canvasId       String
  canvas         Canvas               @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?                @relation(fields: [authorId], references: [id], onDelete: SetNull)
  label          String?
  trigger        CanvasVersionTrigger
  /// SHA-256 of `snapshotJson`, to skip an autosave that changed nothing.
  contentHash    String
  snapshotJson   Json
  markdown       String
  createdAt      DateTime             @default(now())

  @@index([canvasId, createdAt(sort: Desc), id(sort: Desc)])
}
