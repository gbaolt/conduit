# Neon Postgres
# Pooled connection — used by Prisma Client (Neon adapter) at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
# Direct (non-pooled) — used by Prisma migrate
DATABASE_DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=https://api.conduit.localhost
BETTER_AUTH_TRUSTED_ORIGIN=https://conduit.localhost,https://app.conduit.localhost
# Share session cookies across conduit.localhost, app.conduit.localhost, and api.conduit.localhost.
# Required for portless so SSR can read the session cookie. Omit on plain localhost
# (cookie Domain cannot include a port).
AUTH_COOKIE_DOMAIN=.conduit.localhost

# OAuth (optional locally — omit to disable provider)
# Redirect URI: {BETTER_AUTH_URL}/auth/callback/{google|github}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email OTP via Resend (omit RESEND_API_KEY to log OTP to console)
RESEND_API_KEY=
AUTH_EMAIL_FROM=onboarding@resend.dev

# Arcjet (https://console.arcjet.com). ARCJET_ENV=development allows local/private IPs.
ARCJET_KEY=ajkey_replace-me
ARCJET_ENV=development

# App origin used in organization invitation links
APP_URL=https://app.conduit.localhost

# Neon Realtime delivers new messages live (https://neon.com/docs/realtime). Run `neon realtime enable`,
# then `neon env pull --service realtime`. Omit both to start without live updates: history and sending still work.
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=

# AI summaries. AI_SUMMARY_MODEL names the model in whichever provider answers.
# Production reaches models through the Vercel AI Gateway, which signs in with AI_GATEWAY_API_KEY or, on Vercel,
# the deployment's OIDC token. Use a gateway id such as openai/gpt-5-mini there.
# Development uses OpenRouter's free models. Every request sets provider.data_collection to "deny".
# Without a key, the summary procedures refuse with AI_UNAVAILABLE and everything else works.
AI_SUMMARY_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=

# Leave PORT unset under portless (it assigns one). Use PORTLESS=0 pnpm dev:app for a fixed local port.
# PORT=3333

# Workspace icon uploads (S3). Omit to disable: the server still starts, and only
# organizations.iconUploadUrl fails. The bucket must allow public reads on the
# workspaces/ prefix and a CORS PUT from the app origin.
S3_BUCKET=
# "auto" for Cloudflare R2.
S3_REGION=
# Only for an S3-compatible store, e.g. https://<account>.r2.cloudflarestorage.com for R2.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Where uploaded files are served from, with no trailing slash.
S3_PUBLIC_BASE_URL=

# Bearer secret for POST /internal/digests, which the email-digest GitHub workflow calls every 15 minutes.
# The endpoint refuses every request while this is empty. Generate one with `openssl rand -base64 32`.
CRON_SECRET=

# Browser push (Web Push with VAPID). Generate the pair with `npx web-push generate-vapid-keys`.
# Omit them to start without push: everything else works and nothing is sent.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: contact that push services can reach, e.g. mailto:ops@example.com.
VAPID_SUBJECT=
