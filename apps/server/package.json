{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "dev:app": "portless api.conduit nest start --watch",
    "build": "nest build",
    "check:dist": "node scripts/assert-dist.mjs",
    "start": "node dist/src/main.js",
    "start:app": "portless api.conduit node dist/src/main.js",
    "conduit": "nest build && node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate-deploy": "npx prisma migrate deploy",
    "upgrade:nest": "npx npm-check-updates \"/^@nestjs/\" -u"
  },
  "dependencies": {
    "@arcjet/nest": "^1.14.1",
    "@conduit/contract": "workspace:*",
    "@neondatabase/serverless": "^1.0.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@orpc/nest": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@prisma/adapter-neon": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@thallesp/nestjs-better-auth": "^2.7.0",
    "better-auth": "catalog:",
    "dotenv": "^17.4.2",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.0.2",
    "rxjs": "^7.8.2",
    "ws": "^8.18.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conduit/config": "workspace:*",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.0",
    "@types/express": "^5.0.3",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "prisma": "^7.0.0",
    "typescript": "catalog:"
  }
}
