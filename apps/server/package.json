{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "dev:app": "portless api.conduit nest start --watch",
    "build": "nest build",
    "check:dist": "node scripts/assert-dist.mjs",
    "start": "node dist/src/main.js",
    "start:app": "portless api.conduit node dist/src/main.js",
    "conduit": "nest build && node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate-deploy": "npx prisma migrate deploy",
    "db:backfill-default-channels": "tsx scripts/backfill-default-channels.ts",
    "measure:delivery": "tsx scripts/measure-delivery.ts",
    "eval:smart-activity": "tsx scripts/eval-smart-activity.ts",
    "eval:summaries": "tsx scripts/eval-summaries.ts",
    "measure:write-rate": "tsx scripts/measure-write-rate.ts",
    "upgrade:nest": "npx npm-check-updates \"/^@nestjs/\" -u"
  },
  "dependencies": {
    "@arcjet/nest": "^1.14.1",
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1162.0",
    "@conduit/contract": "workspace:*",
    "@neon/realtime": "^0.2.0",
    "@neondatabase/serverless": "^1.0.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@orpc/nest": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@prisma/adapter-neon": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@thallesp/nestjs-better-auth": "^2.7.0",
    "@vercel/functions": "^3.11.0",
    "ai": "^7.0.164",
    "better-auth": "catalog:",
    "dotenv": "^17.4.2",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.0.2",
    "rxjs": "^7.8.2",
    "ws": "^8.18.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@conduit/config": "workspace:*",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.0",
    "@types/express": "^5.0.3",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "prisma": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.157.0"
  }
}
